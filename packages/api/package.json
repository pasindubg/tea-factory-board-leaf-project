{
  "name": "@tea/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:payments": "tsx src/payments/calculate.test.ts",
    "test:auction": "tsx src/auction/parse-acknowledgement.test.ts && tsx src/auction/parse-acknowledgement-asia.test.ts",
    "test:auction2": "tsx src/auction/parse-valuation.test.ts",
    "test:settlement": "tsx src/auction/compute-settlement.test.ts",
    "test:match": "tsx src/auction/match-orphans.test.ts",
    "test:carry-forward": "tsx src/auction/match-carry-forward.test.ts",
    "test:bank": "tsx src/auction/match-bank.test.ts",
    "test:invoice-key": "tsx src/auction/invoice-key.test.ts",
    "test:broker-format": "tsx src/auction/broker-format.test.ts",
    "test:contract-rates": "tsx src/auction/parse-contract-rates.test.ts",
    "test:contract": "tsx src/auction/parse-contract.test.ts",
    "test:dispatch-sheet": "tsx src/auction/parse-dispatch-sheet.test.ts",
    "test:recon-vocab": "tsx src/auction/recon-vocabulary.test.ts",
    "test:corpus": "tsx src/auction/corpus.test.ts",
    "corpus:build": "tsx scripts/build-corpus.mts"
  },
  "dependencies": {
    "@tea/db": "workspace:*",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
