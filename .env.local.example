# Local Supabase CLI stack (`pnpm supabase start`). These are Supabase's fixed
# local-dev defaults — the same for every machine running the CLI locally, not
# secrets. Confirm with `pnpm supabase status -o env` after `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only (bypasses RLS) — use the value from your Supabase project dashboard
SUPABASE_SECRET_KEY=

# Local stack's Postgres (drizzle-kit migrate/seed/verify scripts)
DATABASE_URL=

# --- Background job worker (/api/jobs/tick) ---------------------------------
# Without BOTH of these a queued run never starts: the worker refuses to act,
# and the nudge that would have woken it cannot authenticate itself either. The
# run simply sits at "Waiting to start".
#
# The worker signs a short-lived token for the user a run belongs to, so it can
# act as them with RLS still enforced instead of reaching for the secret key.
# Locally this is the CLI's fixed default — `pnpm supabase status -o env` shows
# it as JWT_SECRET, and it is the same on every machine.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Shared secret the worker endpoint requires. Any long random string locally.
JOBS_TICK_SECRET=local-development-tick-secret
