# Supabase — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only (bypasses RLS) — Dashboard → Project Settings → API Keys
SUPABASE_SECRET_KEY=

# Postgres connection string for Drizzle migrations — Dashboard → Connect → Session pooler
DATABASE_URL=

# --- Neon --------------------------------------------------------------------
# development-01 = local, preview-branch = Vercel Preview, production = Vercel Production.
# All values come from the same branch.
NEXT_PUBLIC_DATA_BACKEND=neon
NEON_DATABASE_URL=
NEON_AUTH_BASE_URL=
NEXT_PUBLIC_NEON_AUTH_BASE_URL=
NEXT_PUBLIC_NEON_DATA_API_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon object storage — `neon env pull --service object-storage` for the branch.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1

# --- Background job worker (/api/jobs/tick) ---------------------------------
# Without BOTH of these a queued run never starts and sits at "Waiting to
# start": the worker refuses to act, and the nudge that would wake it cannot
# authenticate itself either.
#
# The worker signs a short-lived token for the user a run belongs to, so it acts
# as them with RLS still enforced rather than reaching for the secret key. As
# sensitive as SUPABASE_SECRET_KEY — it can mint a token for any user.
# Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# Shared secret the worker endpoint requires before it will do anything.
# Any long random string; `openssl rand -hex 32` is fine.
JOBS_TICK_SECRET=
