# Production config for the field app. Expo loads .env.[mode] with mode =
# production for `expo export` and EAS builds, and overrides the machine-local
# .env used by `expo start`.
#
# Committed on purpose: EXPO_PUBLIC_* values are inlined into the client bundle
# and ship inside every binary, so neither of these is a secret. The
# publishable key is the browser/app-facing key; the secret key never appears
# in this app. EAS builds from a git archive, so a gitignored file would not
# reach the builder at all.
EXPO_PUBLIC_SUPABASE_URL=https://mjptydjrsezqvbrlwooz.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_bG5brrx-tLBlnckJLh64nA_czYBSB-o
