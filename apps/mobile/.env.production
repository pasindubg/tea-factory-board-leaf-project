# Production config for the field app. Expo loads .env.[mode] with mode =
# production for `expo export` and EAS builds, and overrides the machine-local
# .env used by `expo start`.
#
# Committed on purpose: EXPO_PUBLIC_* values are inlined into the client bundle
# and ship inside every binary, so neither of these is a secret. EAS builds from
# a git archive, so a gitignored file would not reach the builder at all.
#
# EXPO_PUBLIC_API_BASE_URL is the production web deployment that serves
# /api/mobile/*.
EXPO_PUBLIC_API_BASE_URL=https://tea-factory-board-leaf-project-web.vercel.app
EXPO_PUBLIC_NEON_DATA_API_URL=https://ep-sweet-river-azg84cej.apirest.c-3.ap-southeast-1.aws.neon.tech/neondb/rest/v1
