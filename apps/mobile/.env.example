# Expo only inlines vars prefixed with EXPO_PUBLIC_ into the client bundle.
# Both of these are client-safe (the publishable key is meant for browsers/apps).
#
# Which file wins, highest priority first:
#   .env.production   committed — hosted project, used by `expo export` and EAS
#   .env              gitignored — YOUR machine, used by `expo start`
#
# Copy this to .env and point it at the local Supabase stack. Use the machine's
# LAN IP, not 127.0.0.1: a phone running Expo Go resolves 127.0.0.1 to itself.
# `ipconfig getifaddr en0` prints it. Re-check it after changing network.
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.100:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
