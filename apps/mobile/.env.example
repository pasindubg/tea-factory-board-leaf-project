# Expo only inlines vars prefixed with EXPO_PUBLIC_ into the client bundle.
# Neither of these is a secret.
#
# Which file wins, highest priority first:
#   .env.production   committed — production web + Neon production branch
#   .env              gitignored — YOUR machine, used by `expo start`
#
# EXPO_PUBLIC_API_BASE_URL is the web app (apps/web) that serves
# /api/mobile/sign-in, /token, /sign-out and /supplier-documents. Use the
# machine's LAN IP, not 127.0.0.1: a phone running Expo Go resolves 127.0.0.1
# to itself. `ipconfig getifaddr en0` prints it.
#
# EXPO_PUBLIC_NEON_DATA_API_URL is the Neon Data API of the branch the web app
# uses (NEXT_PUBLIC_NEON_DATA_API_URL in apps/web).
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:3000
EXPO_PUBLIC_NEON_DATA_API_URL=https://ep-xxx.apirest.c-3.ap-southeast-1.aws.neon.tech/neondb/rest/v1
